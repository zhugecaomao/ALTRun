# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# The entry file keeps its UTF-8 BOM (AutoHotkey reads the encoding from it); line endings are LF like the rest
[ALTRun.ahk]
charset = utf-8-bom

[*.{md,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
