{
    "version": "2026.10.10.1",
    "description": "Lightweight, open-source Alfred-style launcher for Windows",
    "homepage": "https://zhugecaomao.github.io/ALTRun/",
    "license": "GPL-3.0-only",
    "notes": [
        "Start ALTRun from the Start menu, then press Alt+Space.",
        "Settings, indexes, history and custom Themes are kept across updates. Exit ALTRun before 'scoop update altrun'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/zhugecaomao/ALTRun/releases/download/2026.10.10.1/ALTRun_v2026.10.10.1.zip",
            "hash": "8c6182d74958c6c9d703fac888e72f09c6198045da0bb4f217911da0b9be5daa"
        }
    },
    "pre_install": [
        "# Up to 2026.09.26 ALTRun.json was kept next to the program. Copy it in until Data\\ALTRun.json exists: newer versions move it into the persisted Data folder on first start, older ones keep using it",
        "# (copied, not linked: ALTRun saves it by replacing the file, which would break a hard link)",
        "if ((Test-Path \"$persist_dir\\ALTRun.json\") -and !(Test-Path \"$persist_dir\\Data\\ALTRun.json\")) { Copy-Item \"$persist_dir\\ALTRun.json\" \"$dir\\ALTRun.json\" -Force }"
    ],
    "pre_uninstall": [
        "if (Test-Path \"$dir\\ALTRun.json\") {",
        "    New-Item -ItemType Directory \"$persist_dir\" -Force | Out-Null",
        "    Copy-Item \"$dir\\ALTRun.json\" \"$persist_dir\\ALTRun.json\" -Force",
        "}"
    ],
    "persist": [
        "Data",
        "Themes",
        "Scripts"
    ],
    "shortcuts": [
        [
            "ALTRun.exe",
            "ALTRun"
        ]
    ],
    "checkver": {
        "github": "https://github.com/zhugecaomao/ALTRun"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zhugecaomao/ALTRun/releases/download/$version/ALTRun_v$version.zip"
            }
        }
    }
}
