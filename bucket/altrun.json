{
    "version": "2026.09.26",
    "description": "Lightweight, Alfred-style launcher for Windows, written in AutoHotkey v2",
    "homepage": "https://github.com/zhugecaomao/ALTRun",
    "license": "GPL-3.0-only",
    "notes": [
        "Start ALTRun from the Start menu, then press Alt+Space.",
        "Settings (Data\\ALTRun.json), indexes, history and custom Themes are kept across updates. Exit ALTRun before 'scoop update altrun'."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/zhugecaomao/ALTRun/releases/download/2026.09.26/ALTRun_v2026.09.26.zip",
            "hash": "682c9baded7031caad771f8116f346ff071b3deb53f47cf1896965eb20ddbe77"
        }
    },
    "pre_install": [
        "# Up to 2026.09.26 ALTRun.json was kept next to the program and copied to and from persist; now it lives in the persisted Data folder",
        "if ((Test-Path \"$persist_dir\\ALTRun.json\") -and !(Test-Path \"$persist_dir\\Data\\ALTRun.json\")) {",
        "    New-Item -ItemType Directory \"$persist_dir\\Data\" -Force | Out-Null",
        "    Move-Item \"$persist_dir\\ALTRun.json\" \"$persist_dir\\Data\\ALTRun.json\"",
        "}"
    ],
    "persist": [
        "Data",
        "Themes"
    ],
    "shortcuts": [
        [
            "ALTRun.exe",
            "ALTRun"
        ]
    ],
    "checkver": {
        "github": "https://github.com/zhugecaomao/ALTRun"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zhugecaomao/ALTRun/releases/download/$version/ALTRun_v$version.zip"
            }
        }
    }
}
