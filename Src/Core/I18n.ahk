        s["QuickSwitch.SearchCueFolders"] := "Search folders"
        s["QuickSwitch.TagSearch"]     := "Search"
        s["QuickSwitch.TagFile"]       := "File"
        s["QuickSwitch.NoFileManager"] := "No Total Commander, Directory Opus or File Explorer window is open."
        return s
    }
